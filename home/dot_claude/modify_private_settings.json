#!/bin/bash
# Merges managed fields into existing settings.json, preserving everything else.
# Managed fields:
#   - env.DISABLE_AUTOUPDATER, attribution, statusLine, showClearContextOnPlanAccept,
#     skillListingBudgetFraction, askUserQuestionTimeout, worktree.baseRef (replace)
#   - hooks.PreToolUse, hooks.SubagentStart, hooks.SubagentStop, hooks.Stop (per-entry)
#   - permissions.allow/deny (additive)
# A managed hook entry is identified by event, matcher, and the basename of the
# hook command; a handler inside that entry is identified by the basename alone.
# SubagentStart therefore owns two independent entries: matcher "rikki|sakichan"
# for mygo-subagent-context.fish and matcher "rikki" for mygo-subagent-resumed.fish.
# Nothing else takes part in the identity, so a stale copy of one of ours that
# carries extra fields (an old "if" filter, say) is still recognized as ours.
# Only entries and handlers matching one of ours are replaced; every other
# entry in the same event, and every unknown field, is kept. A renamed hook
# is a new identity: its old name goes on the retired list and its handlers
# are dropped before the merge, along with any entry left empty.
#
# Marketplaces and plugins are bootstrapped by run_once_after_install_claude_plugins.sh.tmpl
# via the `claude plugin` CLI; the CLI itself owns enabledPlugins and extraKnownMarketplaces
# in settings.json, so this script does not write those keys.

existing=$(cat)

if [ -z "$existing" ]; then
    existing='{}'
fi

# Permissions we always want denied
deny_permissions='[
  "Bash(sudo:*)"
]'

# Baseline permissions we always want present
baseline_permissions='[
  "WebSearch",
  "Bash(ls:*)",
  "Bash(rg:*)",
  "Bash(fd:*)",
  "Bash(wc:*)",
  "Bash(jq:*)",
  "Bash(which:*)",
  "Bash(echo:*)",
  "Bash(chezmoi diff:*)",
  "Bash(chezmoi status:*)",
  "Bash(git checkout:*)",
  "Bash(git log:*)",
  "Bash(git show-ref:*)",
  "Bash(git ls-tree:*)",
  "Bash(git status:*)",
  "Bash(git diff:*)",
  "Bash(git branch:*)",
  "Bash(git remote:*)",
  "Bash(git stash list:*)",
  "Bash(git fetch:*)",
  "Bash(dotnet build:*)",
  "Bash(dotnet test:*)",
  "Bash(dotnet run:*)",
  "Bash(dotnet restore:*)",
  "Bash(dotnet publish:*)",
  "Bash(dotnet format:*)",
  "Bash(dotnet clean:*)",
  "Bash(dotnet pack:*)",
  "Bash(dotnet add:*)",
  "Bash(dotnet remove:*)",
  "Bash(dotnet list:*)",
  "Bash(dotnet watch:*)",
  "Bash(dotnet tool:*)",
  "Bash(dotnet new:*)"
]'

# Hook entries we own, in the order they are appended to their event.
managed_hooks='[
  {
    "event": "PreToolUse",
    "entry": {
      "matcher": "Agent",
      "hooks": [
        {"type": "command", "command": "\"$HOME/.claude/hooks/mygo-dispatch-guard.fish\"", "timeout": 10}
      ]
    }
  },
  {
    "event": "SubagentStart",
    "entry": {
      "matcher": "rikki|sakichan",
      "hooks": [
        {"type": "command", "command": "\"$HOME/.claude/hooks/mygo-subagent-context.fish\"", "timeout": 10}
      ]
    }
  },
  {
    "event": "SubagentStart",
    "entry": {
      "matcher": "rikki",
      "hooks": [
        {"type": "command", "command": "\"$HOME/.claude/hooks/mygo-subagent-resumed.fish\"", "timeout": 10}
      ]
    }
  },
  {
    "event": "SubagentStop",
    "entry": {
      "matcher": "rikki|sakichan",
      "hooks": [
        {"type": "command", "command": "\"$HOME/.claude/hooks/mygo-subagent-done.fish\"", "timeout": 10}
      ]
    }
  },
  {
    "event": "Stop",
    "entry": {
      "hooks": [
        {"type": "command", "command": "\"$HOME/.claude/hooks/mygo-verification-gate.fish\"", "timeout": 10}
      ]
    }
  }
]'

# Old basenames of renamed hooks.
retired_hooks='[
  "dispatch-guard.fish",
  "subagent-context.fish",
  "subagent-done.fish",
  "subagent-resumed.fish",
  "verification-gate.fish"
]'

echo "$existing" | jq \
    --argjson baseline "$baseline_permissions" \
    --argjson deny "$deny_permissions" \
    --argjson managed_hooks "$managed_hooks" \
    --argjson retired "$retired_hooks" '
  def hook_basename: split("/") | last | sub("\"$"; "");

  def is_retired: (.command? | strings | hook_basename) as $name | $retired | index($name) != null;

  def drop_retired:
    .hooks |= ((. // {}) | with_entries(.value |= map(
      if .hooks == null then .
      else (.hooks |= map(select(is_retired | not))) | select(.hooks | length > 0)
      end)));

  # Handler identity inside an entry: the command basename alone, wrapped in an
  # array so that a handler with no command string keys as [] and never matches
  # one of ours.
  def hook_key: [.command? | strings | hook_basename];

  # Update our handlers in place (our fields win, theirs are kept) and append
  # the ones that are missing. Several existing handlers can share our key
  # (older versions of this script wrote one mygo-dispatch-guard handler per "if"
  # filter); they collapse into a single handler at the position of the first.
  def merge_handlers($ours):
    reduce $ours[] as $our (.;
      . as $handlers |
      ($our | hook_key) as $key |
      [range($handlers | length) as $i | select($handlers[$i] | hook_key == $key) | $i] as $at |
      if ($at | length) == 0 then
        $handlers + [$our]
      else
        (reduce $at[] as $i ({}; . + $handlers[$i])) as $mine |
        (($mine + $our) | if ($our | has("if")) then . else del(.if) end) as $merged |
        [range($handlers | length) as $i
         | select(($at[1:] | index($i)) == null)
         | if $i == $at[0] then $merged else $handlers[$i] end]
      end
    );

  def replace_entry($event; $entry):
    ([$entry.hooks[].command | hook_basename]) as $names |
    ((.hooks[$event]) // []) as $entries |
    ($entries | map(
      ((.matcher // null) == ($entry.matcher // null)) and
      ([.hooks[]? | .command? | strings | hook_basename] | any(. as $name | $names | index($name)))
    ) | index(true)) as $at |
    .hooks[$event] = (
      if $at == null then
        $entries + [$entry]
      else
        $entries | .[$at].hooks = ((.[$at].hooks // []) | merge_handlers($entry.hooks))
      end
    );

  .env.DISABLE_AUTOUPDATER = "1" |
  .attribution = {"commit": "", "pr": "", "sessionUrl": false} |
  .statusLine = {"type": "command", "command": "bunx -y ccstatusline@latest", "padding": 0} |
  .showClearContextOnPlanAccept = true |
  .skillListingBudgetFraction = 0.03 |
  .askUserQuestionTimeout = "60s" |
  .worktree.baseRef = "head" |
  .permissions.allow = ((.permissions.allow // []) + $baseline | unique) |
  .permissions.deny = ((.permissions.deny // []) + $deny | unique) |
  drop_retired |
  reduce $managed_hooks[] as $managed (.; replace_entry($managed.event; $managed.entry))
'
